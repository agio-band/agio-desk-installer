@ECHO OFF

echo SETUP AGIO ENV

CHCP 65001 > NUL 2>&1

SET "DEFAULT_CUSTOM_CONFIG_PATH=%~dp0agio-custom-env.cmd"
SET "USER_CUSTOM_CONFIG_PATH=%APPDATA%\agio\agio-custom-env.cmd"

IF EXIST "%DEFAULT_CUSTOM_CONFIG_PATH%" (
    CALL "%DEFAULT_CUSTOM_CONFIG_PATH%"
)

IF EXIST "%USER_CUSTOM_CONFIG_PATH%" (
    CALL "%USER_CUSTOM_CONFIG_PATH%"
)


set AGIO_CLI={agio_executable}
